# official OS downloaded (.bin/.syx/.zip) + Elektron user manuals
downloads/
*.bin
*.syx
*.zip
*.pdf

# analysis results, patched images, Ghidra project
out/
ghidra_project/

# --- Third party (cloned by setup.sh) ---
vendor/

# --- External RE research: local clone cache (tools/refs/sync.sh) ---
# Only refs/MANIFEST.toml and refs/MANIFEST.lock are tracked; never the repos.
refs/*
!refs/MANIFEST.toml
!refs/MANIFEST.lock

# --- Worktrees (tools/worktree.sh): each thread worktree SYMLINKS these shared inputs; the
# directory patterns above end in '/', which does not match a symlink, so name them again ---
/vendor
/downloads
/ghidra_project

# --- Local ---
reference/KB_REFRESH.md
.DS_Store
.playwright-mcp/
__pycache__/
*.pyc
ghidra_project.bak*/
