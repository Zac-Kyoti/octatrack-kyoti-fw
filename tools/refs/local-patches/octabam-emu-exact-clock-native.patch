+--- a/src/include/unicorn/unicorn.h	2026-09-25 19:36:11
++++ b/src/include/unicorn/unicorn.h	2026-09-25 19:36:26
+@@ -605,6 +605,17 @@
+     // controle if context_save/restore should work with snapshots
+     // Write: @args = (int)
+     UC_CTL_CONTEXT_MODE,
++    // octabam/kyoti: how many instructions the LAST uc_emu_start actually
++    // retired. uc->emu_counter is already maintained in C by the internal
++    // count hook whenever uc_emu_start is given count > 0 (uc.c
++    // hook_count_cb), and it is reset at the top of every uc_emu_start -- so
++    // this is a free, exact read of a number Unicorn already has. Without it
++    // the only way to learn a short burst's true length is a per-instruction
++    // UC_HOOK_CODE callback, which costs ~28x on m68k.
++    // APPENDED DELIBERATELY: every pre-existing UC_CTL_* keeps its value, so
++    // the stock Python bindings stay ABI-compatible with this library.
++    // Read: @args = (size_t*)
++    UC_CTL_UC_EMU_COUNTER,
+ } uc_control_type;
