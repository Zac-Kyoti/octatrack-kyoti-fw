+						std::printf("step mainlvl: %u -> %s\n", lv, g ? "posted" : "NOT FILLED");
+					}
 					else if(verb == "iclock")
 						std::printf("step iclock : %#04x -> clock receive cleared\n", rtos.internalClock());
