 			{
 				std::map<std::string, uint32_t> vars;
+				uint8_t stepRows[8] = {};
 				const auto trim = [](std::string t)
 				{
 					while(!t.empty() && std::isspace(static_cast<unsigned char>(t.front()))) t.erase(t.begin());
