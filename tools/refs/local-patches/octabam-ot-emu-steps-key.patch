# and 'mainlevel N' (SET MAIN LEVEL outside --sequencer). Applies on top of octabam-ot-emu-steps.patch.
# Session 119 (kyoti-v1): used to reproduce and measure the RELOAD [BANK]+[TRACK] stall.
#   git -C refs/octabam apply ../../tools/refs/local-patches/octabam-ot-emu-steps-key.patch
