+						}
+						std::printf("step peek   : %#x : %s\n", addr, out.c_str());
+					}
+					else if(verb == "copy")
+					{
+						const auto eq = rest.find('=');
+						const auto c = rest.find(',', eq == std::string::npos ? 0 : eq);
+						if(eq == std::string::npos || c == std::string::npos)
+						{
+							++failed;
+							std::printf("step copy   : line %zu wants DST=SRC,LEN -- '%s'\n", lineno, l.c_str());
+						}
+						else
+						{
+							const auto dst = resolve(rest.substr(0, eq));
+							const auto src = resolve(rest.substr(eq + 1, c - eq - 1));
+							const auto len = resolve(rest.substr(c + 1));
+							uint32_t nz = 0;
+							for(uint32_t k2 = 0; k2 < len; ++k2)
+							{
+								const auto b = m.read8(src + k2);
+								if(b) ++nz;
+								m.write8(dst + k2, b);
+							}
+							std::printf("step copy   : %#x <- %#x, %u byte%s (%u nonzero)\n",
+								dst, src, len, len == 1 ? "" : "s", nz);
+						}
+					}
+					else if(verb == "frame")
+					{
+						const auto on = rest != "off";
+						rtos.setFrame(on);
+						std::printf("step frame  : DSP frame clock %s\n", on ? "ON" : "off");
+					}
+					else if(verb == "iclock")
+						std::printf("step iclock : %#04x -> clock receive cleared\n", rtos.internalClock());
+					else if(verb == "triglog")
+					{
