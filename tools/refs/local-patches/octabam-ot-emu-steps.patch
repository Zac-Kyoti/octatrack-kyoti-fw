+						const auto len = c == std::string::npos ? 1u : std::max(1u, resolve(rest.substr(c + 1)));
+						std::string out;
+						char b[4];
+						for(uint32_t k2 = 0; k2 < len && k2 < 4096; ++k2)
+						{
