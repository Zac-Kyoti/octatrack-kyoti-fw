+							{
+								size_t n = 0;
+								for(size_t k2 = 0; k2 + 2 <= hex.size(); k2 += 2)
+									m.write8(addr + n++, static_cast<uint8_t>(std::strtoul(hex.substr(k2, 2).c_str(), nullptr, 16)));
+								std::printf("step poke   : %#x <- %zu byte%s\n", addr, n, n == 1 ? "" : "s");
