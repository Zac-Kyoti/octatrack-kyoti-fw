+					if(op != std::string::npos)
+					{
+						const auto off = static_cast<uint32_t>(std::strtoul(t.c_str() + op + 1, nullptr, 0));
+						v = t[op] == '+' ? v + off : v - off;
+					}
+					return v;
+				};
+				std::ifstream f(stepsPath);
+				if(!f)
+				{
+					std::printf("steps      : cannot read %s\n", stepsPath.c_str());
+					return 1;
+				}
+				std::printf("steps      : %s\n", stepsPath.c_str());
+				std::string line;
